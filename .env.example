# Настройки сервера CloudRepairs. Скопируйте в .env (или в EnvironmentFile systemd) и измените.
# Пароль администратора здесь НЕ задаётся — администратор создаётся командой admin:create.

NODE_ENV=production
# Адрес и порт Node.js (снаружи сайт открывается через nginx)
HOST=127.0.0.1
PORT=3000
# Публичный адрес сайта — для sitemap.xml, canonical и Open Graph
PUBLIC_URL=https://cloudrepairs.ru

# Каталог данных: база SQLite (cloudrepairs.db) и загруженные изображения (uploads/)
DATA_DIR=/var/lib/cloudrepairs
# Каталог резервных копий (npm run backup:prod)
BACKUP_DIR=/var/backups/cloudrepairs

# Сайт за nginx: доверять X-Forwarded-For (нужно для ограничения попыток входа по IP)
TRUST_PROXY=true
# Cookie только по HTTPS. В production оставьте true; false — только для локальной проверки по http
COOKIE_SECURE=true

# Сессия администратора: максимальное время жизни (часы) и выход при бездействии (минуты)
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120

# Ограничение попыток входа: N неудачных попыток за окно — блокировка до конца окна
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Максимальный размер загружаемого изображения, МБ
MAX_UPLOAD_MB=10
